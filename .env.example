CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token
CHANNEL_SECRET=replace-with-line-channel-secret
FIREBASE_CREDENTIALS={"type":"service_account"}
FIREBASE_DATABASE_URL=https://pharmacy-bot-fd2cb-default-rtdb.asia-southeast1.firebasedatabase.app
# Optional: comma-separated LINE group IDs. Leave empty during the pilot.
ALLOWED_GROUP_IDS=
# Optional: comma-separated LINE user IDs allowed to complete records.
# Leave empty during the pilot to allow all group members.
ADMIN_USER_IDS=
# Optional: JSON object mapping a drug name to local brand/generic aliases.
DRUG_ALIASES_JSON={"augmentin":["安滅菌","amoxicillin/clavulanate"]}
# LINE group ID that receives the daily 08:00 handover summary.
DAILY_SUMMARY_GROUP_ID=
# Random secret used by Vercel Cron to authorize the scheduled endpoint.
CRON_SECRET=
